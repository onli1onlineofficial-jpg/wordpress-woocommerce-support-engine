/** -------------------------------------------------------------------------
 * Database Configuration
 * ------------------------------------------------------------------------- */

define('DB_NAME', 'your_database_name');

define('DB_USER', 'your_database_user');

define('DB_PASSWORD', 'your_database_password');

define('DB_HOST', 'localhost');

define('DB_CHARSET', 'utf8mb4');

define('DB_COLLATE', '');

/** -------------------------------------------------------------------------
 * Authentication Unique Keys and Salts
 * ------------------------------------------------------------------------- */

define('AUTH_KEY',         'replace-with-generated-key');
define('SECURE_AUTH_KEY',  'replace-with-generated-key');
define('LOGGED_IN_KEY',    'replace-with-generated-key');
define('NONCE_KEY',        'replace-with-generated-key');
define('AUTH_SALT',        'replace-with-generated-key');
define('SECURE_AUTH_SALT', 'replace-with-generated-key');
define('LOGGED_IN_SALT',   'replace-with-generated-key');
define('NONCE_SALT',       'replace-with-generated-key');

/** -------------------------------------------------------------------------
 * Database Table Prefix
 * ------------------------------------------------------------------------- */

$table_prefix = 'wp_';

/** -------------------------------------------------------------------------
 * WordPress Debugging
 * ------------------------------------------------------------------------- */

define('WP_DEBUG', true);

define('WP_DEBUG_LOG', true);

define('WP_DEBUG_DISPLAY', false);

@ini_set('display_errors', 0);

/** -------------------------------------------------------------------------
 * Memory Limits
 * ------------------------------------------------------------------------- */

define('WP_MEMORY_LIMIT', '256M');

define('WP_MAX_MEMORY_LIMIT', '512M');

/** -------------------------------------------------------------------------
 * Autosave & Revisions
 * ------------------------------------------------------------------------- */

define('AUTOSAVE_INTERVAL', 300);

define('WP_POST_REVISIONS', 10);

/** -------------------------------------------------------------------------
 * Cron
 * ------------------------------------------------------------------------- */

// Set to true if using a system cron instead of WP-Cron.
// define('DISABLE_WP_CRON', true);

/** -------------------------------------------------------------------------
 * File Editing
 * ------------------------------------------------------------------------- */

// Disable the built-in plugin and theme editor in production.
// define('DISALLOW_FILE_EDIT', true);

/** -------------------------------------------------------------------------
 * Automatic Updates
 * ------------------------------------------------------------------------- */

// Enable automatic core updates.
// define('WP_AUTO_UPDATE_CORE', true);

/** -------------------------------------------------------------------------
 * SSL
 * ------------------------------------------------------------------------- */

// Force SSL for administration if required.
// define('FORCE_SSL_ADMIN', true);

/** -------------------------------------------------------------------------
 * Absolute Path
 * ------------------------------------------------------------------------- */

if (!defined('ABSPATH')) {
    define('ABSPATH', __DIR__ . '/');
}

/** -------------------------------------------------------------------------
 * Bootstrap WordPress
 * ------------------------------------------------------------------------- */

require_once ABSPATH . 'wp-settings.php';
